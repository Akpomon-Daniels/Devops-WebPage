pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/Akpomon-Daniels/Devops-WebPage.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t web-page .'
            }
        }

        stage('Deploy Container') {
            steps {
                sh 'docker stop web-page || true'
                sh 'docker rm web-page || true'
                sh 'docker run -d -p 5000:80 --name web-page web-page'
            }
        }
    }
}
